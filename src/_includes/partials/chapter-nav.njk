<nav class="chapter-nav">
  {% if prev %}
    <a href="{{ prev.url }}" class="chapter-nav-link prev">
      <span class="nav-arrow">←</span>
      <span class="nav-text">{{ prev.data.title }}</span>
    </a>
  {% endif %}
  {% if next %}
    <a href="{{ next.url }}" class="chapter-nav-link next">
      <span class="nav-text">{{ next.data.title }}</span>
      <span class="nav-arrow">→</span>
    </a>
  {% endif %}
</nav>