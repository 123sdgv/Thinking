---
layout: layouts/base.njk
---
{% set sortedChapters = collections.chapters | storyChapters(story) %}
{% set currentIdx = sortedChapters | findCurrentIndex(page) %}
{% set prevChapter = sortedChapters[currentIdx - 1] if currentIdx > 0 else null %}
{% set nextChapter = sortedChapters[currentIdx + 1] if currentIdx < (sortedChapters.length - 1) else null %}

<article class="chapter-page">
  
  <!-- 顶部导航栏 -->
  <nav class="chapter-top-nav">
    {% set parentStory = collections.stories | findBySlug(story) %}
    {% if parentStory %}
      <a href="{{ parentStory.url }}" class="back-to-story">← 返回《{{ parentStory.data.title }}》</a>
    {% else %}
      <a href="/stories/" class="back-to-story">← 返回故事列表</a>
    {% endif %}
  </nav>
  
  <header class="chapter-header">
    <h1>{{ title }}</h1>
    <div class="chapter-meta">
      {% if date %}
        <span class="meta-item">📅 {{ date }}</span>
      {% endif %}
      {% if location %}
        <span class="meta-item">📍 {{ location }}</span>
      {% endif %}
      {% if word_count %}
        <span class="meta-item">📝 {{ word_count }} 字</span>
      {% endif %}
    </div>
  </header>
  
  <!-- 正文内容 -->
  <div class="chapter-content">
    {{ content | safe }}
  </div>
  
  <!-- 底部章节导航 -->
  {% if sortedChapters.length > 1 %}
  <nav class="chapter-bottom-nav">
    {% if prevChapter %}
      <a href="{{ prevChapter.url }}" class="nav-prev">← {{ prevChapter.data.title }}</a>
    {% else %}
      <span class="nav-placeholder"></span>
    {% endif %}
    
    <span class="nav-position">{{ currentIdx + 1 }} / {{ sortedChapters.length }}</span>
    
    {% if nextChapter %}
      <a href="{{ nextChapter.url }}" class="nav-next">{{ nextChapter.data.title }} →</a>
    {% else %}
      <span class="nav-placeholder"></span>
    {% endif %}
  </nav>
  {% endif %}
  
</article>